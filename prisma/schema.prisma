// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ParcelStatus {
  PENDING_APPROVAL
  APPROVED
  PENDING
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
  ESCALATED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintCategory {
  DELIVERY_DELAY
  DAMAGED_PARCEL
  LOST_PARCEL
  WRONG_DELIVERY
  CUSTOMER_SERVICE
  BILLING
  TRACKING_ISSUE
  OTHER
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  parcels      Parcel[]           @relation("UserParcels")
  assignedParcels Parcel[]         @relation("StaffParcels")
  notifications Notification[]
  statusHistory StatusHistory[]
  complaints   Complaint[]        @relation("UserComplaints")
  staffComplaints Complaint[]     @relation("StaffComplaints")
  complaintResponses ComplaintResponse[]
  requestedApprovals ApprovalQueue[] @relation("RequestedApprovals")
  approvedApprovals ApprovalQueue[] @relation("ApprovedApprovals")
  rejectedApprovals ApprovalQueue[] @relation("RejectedApprovals")

  @@map("users")
}

model Parcel {
  id                 String        @id @default(cuid())
  trackingId         String        @unique
  userId             String
  staffId            String?
  status             ParcelStatus  @default(PENDING)
  origin             String
  destination        String
  currentLocation    String?
  weight             Float?
  dimensions         String?
  description        String?
  value              Float?        // Added value field
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user               User          @relation("UserParcels", fields: [userId], references: [id])
  staff              User?         @relation("StaffParcels", fields: [staffId], references: [id])
  statusHistory      StatusHistory[]
  notifications      Notification[]
  proofOfDelivery    ProofOfDelivery?
  complaints         Complaint[]    @relation("ParcelComplaints")
  approvalQueue      ApprovalQueue?

  @@map("parcels")
}

model StatusHistory {
  id          String        @id @default(cuid())
  parcelId    String
  status      ParcelStatus
  location    String
  description String?
  timestamp   DateTime      @default(now())
  updatedBy   String

  // Relations
  parcel      Parcel        @relation(fields: [parcelId], references: [id])
  user        User          @relation(fields: [updatedBy], references: [id])

  @@map("status_history")
}

model Notification {
  id          String             @id @default(cuid())
  userId      String
  parcelId    String?
  message     String
  type        NotificationType
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  sentAt      DateTime?
  error       String?

  // Relations
  user        User               @relation(fields: [userId], references: [id])
  parcel      Parcel?            @relation(fields: [parcelId], references: [id])

  @@map("notifications")
}

model ProofOfDelivery {
  id             String   @id @default(cuid())
  parcelId       String   @unique
  imageUrl       String?
  signature      String?
  recipientName  String
  recipientPhone String?
  notes          String?
  timestamp      DateTime @default(now())

  // Relations
  parcel         Parcel   @relation(fields: [parcelId], references: [id])

  @@map("proof_of_delivery")
}

model Complaint {
  id              String            @id @default(cuid())
  trackingId      String?
  parcelId        String?
  userId          String
  staffId         String?
  title           String
  description     String
  category        ComplaintCategory
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  resolution      String?
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user            User              @relation("UserComplaints", fields: [userId], references: [id])
  staff           User?             @relation("StaffComplaints", fields: [staffId], references: [id])
  parcel          Parcel?           @relation("ParcelComplaints", fields: [parcelId], references: [id])
  responses       ComplaintResponse[]

  @@map("complaints")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ComplaintResponse {
  id          String   @id @default(cuid())
  complaintId String
  staffId     String
  message     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  staff       User      @relation(fields: [staffId], references: [id])

  @@map("complaint_responses")
}

model ApprovalQueue {
  id              String        @id @default(cuid())
  parcelId        String        @unique
  requestedBy     String
  requestedAt     DateTime      @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  status          ApprovalStatus @default(PENDING)

  // Relations
  parcel          Parcel        @relation(fields: [parcelId], references: [id])
  requester       User          @relation("RequestedApprovals", fields: [requestedBy], references: [id])
  approver       User?         @relation("ApprovedApprovals", fields: [approvedBy], references: [id])
  rejecter       User?         @relation("RejectedApprovals", fields: [rejectedBy], references: [id])

  @@map("approval_queue")
}